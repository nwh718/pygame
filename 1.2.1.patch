"""
增强版五子棋胜负判断函数
基于 15x15 棋盘坐标系统
"""

class Checkerboard:
    def __init__(self, line_points=15):
        self._line_points = line_points
        self._checkerboard = [[0] * line_points for _ in range(line_points)]
    
    def check_win(self, point, value):
        """
        落子后胜负判断函数
        :param point: 落子位置 Point(X, Y)
        :param value: 棋子值 (1=黑, 2=白)
        :return: 获胜返回 True，否则返回 False
        """
        # 检查水平方向
        if self._check_direction(point, value, 1, 0):
            return True
        
        # 检查垂直方向
        if self._check_direction(point, value, 0, 1):
            return True
        
        # 检查对角线方向 (左上到右下)
        if self._check_direction(point, value, 1, 1):
            return True
        
        # 检查对角线方向 (右上到左下)
        if self._check_direction(point, value, 1, -1):
            return True
        
        return False
    
    def _check_direction(self, point, value, x_offset, y_offset):
        """
        检查指定方向上是否有五子连珠
        :param point: 起始点
        :param value: 棋子值
        :param x_offset: X 方向偏移量
        :param y_offset: Y 方向偏移量
        :return: 达到五子连珠返回 True，否则返回 False
        """
        count = 1
        
        # 向正方向检查
        for step in range(1, 5):
            x = point.X + step * x_offset
            y = point.Y + step * y_offset
            # 边界条件判断
            if 0 <= x < self._line_points and 0 <= y < self._line_points:
                if self._checkerboard[y][x] == value:
                    count += 1
                else:
                    break
            else:
                break
        
        # 向反方向检查
        for step in range(1, 5):
            x = point.X - step * x_offset
            y = point.Y - step * y_offset
            # 边界条件判断
            if 0 <= x < self._line_points and 0 <= y < self._line_points:
                if self._checkerboard[y][x] == value:
                    count += 1
                else:
                    break
            else:
                break
        
        return count >= 5
