++"""五子棋棋盘模块 —— 胜负判定"""
++
++from collections import namedtuple
++
++Point = namedtuple('Point', 'X Y')
++
++BLACK = 1
++WHITE = 2
++
++DIRECTIONS = [
++    (1, 0),   # 水平
++    (0, 1),   # 垂直
++    (1, 1),   # 左上-右下 对角线
++    (1, -1),  # 右上-左下 对角线
++]
++
++BOARD_SIZE = 19
++
++
++class Board:
++    def __init__(self, size=BOARD_SIZE):
++        self.size = size
++        self.grid = [[0] * size for _ in range(size)]
++
++    def place(self, x, y, color):
++        self.grid[y][x] = color
++
++    def can_place(self, x, y):
++        return 0 <= x < self.size and 0 <= y < self.size and self.grid[y][x] == 0
++
++    # ── 原始版：仅支持水平 + 垂直 ──────────────────────────────────
++    def check_win_v1(self, x, y, color):
++        directions = [(1, 0), (0, 1)]
++        for dx, dy in directions:
++            count = 1
++            for step in range(1, 5):
++                nx, ny = x + step * dx, y + step * dy
++                if 0 <= nx < self.size and 0 <= ny < self.size and self.grid[ny][nx] == color:
++                    count += 1
++                else:
++                    break
++            for step in range(1, 5):
++                nx, ny = x - step * dx, y - step * dy
++                if 0 <= nx < self.size and 0 <= ny < self.size and self.grid[ny][nx] == color:
++                    count += 1
++                else:
++                    break
++            if count >= 5:
++                return True
++        return False
++
++    # ── 改进版：水平 + 垂直 + 两条对角线 ──────────────────────────
++    def check_win(self, x, y, color):
++        for dx, dy in DIRECTIONS:
++            count = 1
++            for step in range(1, 5):
++                nx, ny = x + step * dx, y + step * dy
++                if 0 <= nx < self.size and 0 <= ny < self.size and self.grid[ny][nx] == color:
++                    count += 1
++                else:
++                    break
++            for step in range(1, 5):
++                nx, ny = x - step * dx, y - step * dy
++                if 0 <= nx < self.size and 0 <= ny < self.size and self.grid[ny][nx] == color:
++                    count += 1
++                else:
++                    break
++            if count >= 5:
++                return True
++        return False
++
++
++# ── 模块级便捷函数，与类方法签名一致 ─────────────────────────────
++_default_board = Board()
++
++
++def check_win(x, y, color, board=None):
++    if board is None:
++        board = _default_board
++    return board.check_win(x, y, color)
